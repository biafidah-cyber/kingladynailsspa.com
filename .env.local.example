# ─────────────────────────────────────────────────────────────────────────────
# .env.local — Copy this to .env.local and fill in your keys
# NEVER commit .env.local to Git!
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin Security (Recommended — protects all admin API routes) ──────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=your-random-secret-here
# Must match ADMIN_SECRET — allows the browser admin UI to send the auth header in dev
NEXT_PUBLIC_ADMIN_SECRET=your-random-secret-here

# ── AI Content Generation (Required for admin panel) ─────────────────────────
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY_HERE

# ── DataForSEO (for keyword research in admin) ───────────────────────────────
# Already have these from LeadHunter!
DATAFORSEO_LOGIN=your_email@example.com
DATAFORSEO_PASSWORD=your_dataforseo_password

# ── Newsletter — ConvertKit / Kit (optional) ──────────────────────────────────
# Sign up free at: https://kit.com
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# ── Newsletter — Mailchimp (optional — alternative to ConvertKit) ─────────────
# Get API key at: https://mailchimp.com/developer/
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_DC=us1

# ── Google Analytics (GA4) ───────────────────────────────────────────────────
# Find in GA4 → Admin → Data Streams → Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Google Search Console ─────────────────────────────────────────────────────
# GSC → Settings → Ownership Verification → HTML meta tag (just the content=".." value)
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Site URL (set to your production domain for Amplify) ─────────────────────
NEXT_PUBLIC_SITE_URL=https://kingladynailsspa.com

# ── Upstash Redis (for persistent rate limiting on public routes) ─────────────
# Free at https://upstash.com → Create Database → REST API tab
# Without this, /api/subscribe uses in-memory rate limiting (resets on restart)
UPSTASH_REDIS_REST_URL=https://YOUR_ID.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── Giscus Comments (for blog post comment sections) ─────────────────────────
# Free — uses GitHub Discussions as comment store. No backend needed.
# Setup: https://giscus.app — fill in your repo → copy the 4 values below
NEXT_PUBLIC_GISCUS_REPO=username/repo-name
NEXT_PUBLIC_GISCUS_REPO_ID=R_xxxxxxxxxxxx
NEXT_PUBLIC_GISCUS_CATEGORY=General
NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_xxxxxxxxxxxx

# ── Contact Form (Formspree) ──────────────────────────────────────────────────
# Free tier: 50 submissions/month. Sign up at https://formspree.io
# Create a form → copy the 8-char form ID from the endpoint URL
NEXT_PUBLIC_FORMSPREE_ID=
